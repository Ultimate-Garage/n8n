# Copy this file to .env, then replace every CHANGE_ME value before starting.

# Image pinning. Use a specific n8n version in production instead of latest.
N8N_VERSION=latest

# Public URL settings. WEBHOOK_URL must be the externally reachable HTTPS URL.
N8N_HOST=n8n.guirage.com
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.guirage.com/
N8N_SECURE_COOKIE=true
GENERIC_TIMEZONE=America/Toronto

# n8n credential encryption. Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=d356fecfb9d3a1091a3a60c93888b86f5bc9381db6703b77da8e667433711405

# n8n application preferences and data retention.
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
EXECUTIONS_DATA_MAX_AGE=336
N8N_WORKER_CONCURRENCY=10

# PostgreSQL used by n8n itself.
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=8bd911dc796c9982d7ea721d10db587c48cb1d99e28f4120

# Redis queue backend used by n8n and workers.
REDIS_PASSWORD=cfa42c1d40f98cae18bff95bd388aa7e72969bb9fafe91b2

# Azure SQL / Microsoft SQL values for the native n8n Microsoft SQL credential.
# These are documented here for operators; enter them in n8n under
# Credentials > Microsoft SQL. They are not the database n8n stores its data in.
AZURE_SQL_SERVER=solara-sql-server1.database.windows.net
AZURE_SQL_PORT=1433
AZURE_SQL_DATABASE=solara-data-01
AZURE_SQL_USER=n8n
AZURE_SQL_PASSWORD=cebc9eacd9b2eac96fd980dca01f72a59628cbbfb8147286-
AZURE_SQL_ENCRYPT=true
AZURE_SQL_TRUST_SERVER_CERTIFICATE=false
AZURE_SQL_CONNECTION_TIMEOUT=15000
